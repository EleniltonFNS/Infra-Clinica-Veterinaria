# Arquivo modelo de variáveis de ambiente para a infraestrutura da clínica veterinária.

# Rede interna da clínica, usada pelo médico veterinário
LAN_SUBNET=10.77.1.0/24
# Rede isolada para serviços, como o servidor web e o servidor de banco de dados
DMZ_SUBNET=10.77.2.0/24
# Rede externa, usada para acesso remoto pelo tutor do pet
EXTERNAL_SUBNET=10.77.3.0/24

# Endereços IP dos firewalls para cada rede
FIREWALL_LAN_IP=10.77.1.254
FIREWALL_DMZ_IP=10.77.2.254
FIREWALL_EXTERNAL_IP=10.77.3.254

# Endereços IP dos clientes
MEDICO_IP=10.77.1.10
TUTOR_IP=10.77.3.10

# Endereços IP dos serviços na DMZ
WEB_IP=10.77.2.10
DB_IP=10.77.2.11
PRONTUARIO_IP=10.77.2.12

# Credenciais fictícias do banco
DB_NAME=clinica
DB_USER=clinica_app
DB_PASSWORD=senha_do_laboratorio